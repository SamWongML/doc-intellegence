# syntax=docker/dockerfile:1.7
# Heavy-profile worker: adds Chromium + Playwright for Crawl4AI.
# This image is intentionally fat (~1 GB) — it should only be deployed to the
# heavy SQS queue's worker fleet. Light traffic stays on Dockerfile.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Chromium runtime deps. Keep this list aligned with `playwright install-deps`.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libglib2.0-0 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Workspace metadata first for cache-friendly dep resolution.
COPY pyproject.toml uv.lock README.md ./
COPY packages/shared/pyproject.toml ./packages/shared/pyproject.toml
COPY services/worker/pyproject.toml ./services/worker/pyproject.toml

RUN pip install --no-cache-dir uv==0.8.17 \
 && uv sync --frozen --no-dev --package doc-search-worker --extra heavy

# Install the Chromium binary into PLAYWRIGHT_BROWSERS_PATH.
RUN /app/.venv/bin/python -m playwright install chromium

COPY packages/shared ./packages/shared
COPY services/worker ./services/worker

ENV WORKER_PROFILE=heavy \
    DOC_SEARCH_LOG_JSON=true \
    PATH="/app/.venv/bin:${PATH}"

ENTRYPOINT ["python", "-m", "doc_search_worker"]
