# syntax=docker/dockerfile:1.7
# Heavy-profile worker: adds Chromium + Playwright (Crawl4AI) and Docling.
# This image is intentionally fat (~3-4 GB after docling model weights) and
# should only be deployed to the heavy SQS queue's worker fleet. Light
# traffic stays on Dockerfile.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HF_HOME=/opt/docling-cache/hf \
    DOCLING_ARTIFACTS_PATH=/opt/docling-cache/docling

# Chromium runtime deps (aligned with `playwright install-deps`) plus libgl1
# / libgomp1 which Docling's OCR + image pipelines (opencv, onnxruntime) need.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-liberation \
        libasound2 \
        libatk-bridge2.0-0 \
        libatk1.0-0 \
        libatspi2.0-0 \
        libcairo2 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        libgtk-3-0 \
        libnspr4 \
        libnss3 \
        libpango-1.0-0 \
        libx11-6 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Workspace metadata first for cache-friendly dep resolution.
COPY pyproject.toml uv.lock README.md ./
COPY packages/shared/pyproject.toml ./packages/shared/pyproject.toml
COPY services/worker/pyproject.toml ./services/worker/pyproject.toml

RUN pip install --no-cache-dir uv==0.8.17 \
 && uv sync --frozen --no-dev --package doc-search-worker --extra heavy

# Install the Chromium binary into PLAYWRIGHT_BROWSERS_PATH.
RUN /app/.venv/bin/python -m playwright install chromium

# Pre-fetch Docling model weights (~1-2 GB) so cold-start jobs do not stall
# on the first conversion. If image size becomes a concern, drop this step
# and mount an EFS volume at $DOCLING_ARTIFACTS_PATH instead.
RUN mkdir -p "$DOCLING_ARTIFACTS_PATH" \
 && /app/.venv/bin/python -m docling.cli.main models download --output-dir "$DOCLING_ARTIFACTS_PATH" \
        || /app/.venv/bin/python -c "from docling.utils.model_downloader import download_models; download_models('$DOCLING_ARTIFACTS_PATH')"

COPY packages/shared ./packages/shared
COPY services/worker ./services/worker

ENV WORKER_PROFILE=heavy \
    DOC_SEARCH_LOG_JSON=true \
    PATH="/app/.venv/bin:${PATH}"

ENTRYPOINT ["python", "-m", "doc_search_worker"]
